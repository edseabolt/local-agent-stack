# Connection settings consumed by the /omlx-install skill (see AGENTS.md).
# The installed opencode.jsonc gets literal baseURL/apiKey, so OpenCode itself
# does not read these at launch — source .env only if another tool needs them.
#
# OMLX_HOST: LAN hostname of the Mac Studio running oMLX (no port)
OMLX_HOST=REPLACE_ME_HOST
# Derived from OMLX_HOST by /omlx-install — edit only for a non-default port
# (the installer honors an explicitly set value)
OMLX_BASE_URL=http://REPLACE_ME_HOST:8000/v1
# Must match auth.api_key in the installed ~/.omlx/settings.json
OMLX_API_KEY=REPLACE_ME
# oMLX admin secret — generated by /omlx-install if missing (openssl-rand-hex-32 equivalent)
OMLX_SECRET_KEY=REPLACE_ME
