  "cache": {
    "enabled": true,
    "hot_cache_only": true,
    "gdn_ssd_split_enabled": false,
    "gdn_snapshot_storage": "auto",
    "gdn_ssd_pending_max_size": "512MB",
    "gdn_sidecar_precision": "fp32",
    "ssd_cache_dir": "/Users/YOUR_USER/.omlx/cache",
    "ssd_cache_max_size": "37GB",
    "hot_cache_max_size": "128GB",
    "hot_cache_write_through": false,
    "ane_compile_cache": false,
    "initial_cache_blocks": 4096
  },
  "auth": {
    "api_key": "REPLACE_ME",
    "secret_key": "REPLACE_ME_WITH_openssl_rand_-hex_32",
    "skip_api_key_verification": false,
    "allow_unauthenticated_inference": false,
    "sub_keys": []
  },
  "mcp": {
    "config_path": null,
    "expose_tools": true
  },
  "huggingface": {
    "endpoint": "",
    "hf_cache_enabled": false
  },
  "modelscope": {
    "endpoint": ""
  },
  "network": {
    "http_proxy": "",
    "https_proxy": "",
    "no_proxy": "",
    "ca_bundle": ""
  },
  "sampling": {
    "max_context_window": 65536,
    "max_context_window_policy": null,
    "max_tokens": 65536,
    "temperature": 0.3,
    "top_p": 0.9,
    "top_k": 0,
    "repetition_penalty": 1.0
  },
  "logging": {
    "log_dir": "/Users/YOUR_USER/.omlx/logs",
    "retention_days": 7
  },
  "claude_code": {
    "mode": "cloud",
    "opus_model": null,
    "sonnet_model": null,
    "haiku_model": null
  },
  "integrations": {
    "codex_model": null,
    "opencode_model": "Ornith-1.5-35B-A3B-oQ8-mtp",
    "openclaw_model": null,
    "hermes_model": null,
    "pi_model": null,
    "copilot_model": null,
    "dsh_model": null,
    "openclaw_tools_profile": "coding",
