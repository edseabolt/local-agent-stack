{
  "version": "1.0",
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "log_level": "info",
    "cors_origins": [
      "http://localhost",
      "http://127.0.0.1",
      "http://your-mac.local"
    ],
    "server_aliases": [
      "localhost",
      "127.0.0.1",
      "your-mac.local"
    ],
    "sse_keepalive_mode": "chunk",
    "auto_start_on_launch": true,
    "burst_decode_mode": "aggressive",
    "preserve_mid_system_cache": true,
    "qwen4_gdn_decode_wide_proj": false,
    "distributed_inference_enabled": false,
    "max_audio_upload_size": "100MB",
    "max_image_upload_size": "50MB",
    "max_image_side_length": 2048,
    "gpu_keep_warm_interval": 0.5
  },
  "model": {
    "model_dirs": [
      "/Users/YOUR_USER/.omlx/models"
    ],
    "model_dir": "/Users/YOUR_USER/.omlx/models",
    "model_fallback": true,
    "hide_helper_models": false
  },
  "memory": {
    "prefill_memory_guard": false,
    "memory_guard_tier": "aggressive",
    "memory_guard_custom_ceiling_gb": 384.0,
    "soft_threshold": 0.9,
    "hard_threshold": 0.98,
    "prefill_safe_zone_ratio": 0.9,
    "prefill_min_chunk_tokens": 1024
