{
  "$schema": "https://opencode.ai/config.json",
  "model": "oMLX/oQ/GLM-5.3-Flash-oQ4-mtp",
  "update": "notify",
  "plugins": [],
  "agents": {
    "title": {
      "model": "oMLX/oQ/Ornith-1.5-35B-A3B-oQ8-mtp"
    },
    "summary": {
      "model": "oMLX/oQ/Ornith-1.5-35B-A3B-oQ8-mtp"
    },
    "planner": {
      "model": "oMLX/oQ/Qwen3.8-Flash-Next-oQ4-mtp"
    },
    "plan-reviewer": {
      "model": "oMLX/oQ/GLM-5.3-Flash-oQ4-mtp"
    },
    "executor": {
      "model": "oMLX/oQ/Qwen3.8-27B-oQ8-mtp"
    },
    "test-runner": {
      "model": "oMLX/oQ/Qwen3.8-27B-oQ8-mtp"
    },
    "reviewer": {
      "model": "oMLX/oQ/GLM-5.3-Flash-oQ4-mtp"
    },
    "debugger": {
      "model": "oMLX/oQ/GLM-5.3-Flash-oQ4-mtp"
    }
  },
  "permissions": [
    {
      "action": "read",
