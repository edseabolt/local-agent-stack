  "providers": {
    "oMLX": {
      "name": "oMLX",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OMLX_BASE_URL}",
        "apiKey": "{env:OMLX_API_KEY}"
      },
      "models": {
        "oQ/GLM-5.3-Flash-oQ4-mtp": {
          "name": "GLM-5.3 Flash (local)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": [
            {
              "id": "precise",
              "body": {
                "temperature": 0.1
              }
            },
            {
              "id": "balanced",
              "body": {
                "temperature": 0.5
              }
            },
            {
              "id": "creative",
              "body": {
                "temperature": 0.9
              }
            }
          ]
        },
        "oQ/Qwen3.8-Flash-Next-oQ4-mtp": {
          "name": "Qwen3.8 Flash-Next (local)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "variants": [
            {
              "id": "precise",
              "body": {
                "temperature": 0.1
              }
            },
            {
              "id": "balanced",
              "body": {
                "temperature": 0.5
              }
            },
            {
              "id": "creative",
              "body": {
                "temperature": 0.9
              }
            }
          ]
        },
        "oQ/Qwen3.8-27B-oQ8-mtp": {
          "name": "Qwen3.8 27B (local)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "variants": [
            {
              "id": "precise",
              "body": {
                "temperature": 0.1
              }
            },
            {
              "id": "balanced",
              "body": {
                "temperature": 0.5
              }
            },
            {
              "id": "creative",
              "body": {
                "temperature": 0.9
              }
            }
          ]
        },
        "oQ/Ornith-1.5-35B-A3B-oQ8-mtp": {
          "name": "Ornith-1.5 35B A3B (local)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
